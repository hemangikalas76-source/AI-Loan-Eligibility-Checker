# ================================================================
# AI Loan Eligibility Checker - Environment Configuration
# ================================================================

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
FLASK_DEBUG=True

# AI Provider Configuration
# Options: claude, groq
# If neither is configured, the application will use local rule-based guidance
AI_PROVIDER=claude

# Claude AI Configuration
# Get your API key from: https://console.anthropic.com/
# Do NOT expose this key in frontend code
CLAUDE_API_KEY=your_claude_api_key_here

# Groq API Configuration (Alternative to Claude)
# Get your API key from: https://console.groq.com/
# Do NOT expose this key in frontend code
GROQ_API_KEY=your_groq_api_key_here

# Google Sheets Integration
# Create a Google Apps Script Web App and paste the endpoint URL here
# This is optional - the application will work without it
# Instructions: https://developers.google.com/apps-script
GOOGLE_SHEETS_ENDPOINT=https://script.google.com/macros/d/YOUR_SCRIPT_ID/userweb?v=1

# ================================================================
# IMPORTANT SECURITY NOTES:
# ================================================================
# 1. NEVER commit this file with real API keys to Git
# 2. Use .gitignore to exclude .env files
# 3. Keep API keys secure and rotate them regularly
# 4. The .env file should only be used in development
# 5. In production, use your deployment platform's secrets management
#    (e.g., AWS Secrets Manager, Google Cloud Secret Manager, etc.)
# 6. The frontend NEVER accesses API keys - they remain on the backend
